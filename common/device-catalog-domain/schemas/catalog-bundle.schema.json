{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "catalog-bundle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundleVersion", "profile", "recipes"],
  "properties": {
    "bundleVersion": { "const": "1.0" },
    "profile": { "$ref": "device-profile.schema.json" },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "recipe.schema.json" }
    }
  }
}
