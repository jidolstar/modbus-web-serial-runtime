{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "catalog-ai-generation-result.schema.json",
  "oneOf": [
    {
      "$ref": "catalog-ai-proposal.schema.json"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "missingEvidence", "reasons"],
      "properties": {
        "outcome": {
          "const": "insufficientEvidence"
        },
        "missingEvidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": ["modbusProtocol", "readableMeasurement", "requestedChange"]
          }
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    }
  ]
}
