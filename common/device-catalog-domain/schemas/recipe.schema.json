{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "recipe.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "kind", "steps", "onError"],
  "properties": {
    "schemaVersion": { "enum": ["1.0", "2.0"] },
    "id": { "$ref": "#/definitions/id" },
    "name": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["measurement", "configuration"] },
    "applyMode": {
      "enum": ["immediate", "after-power-cycle"],
      "description": "설정 write가 즉시 적용되는지, 사용자의 물리적 전원 재인가 후 적용되는지 나타냅니다. 생략하면 immediate입니다."
    },
    "parameters": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/integerParameter" },
          { "$ref": "#/definitions/enumParameter" }
        ]
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/readHoldingRegistersStep" },
          { "$ref": "#/definitions/writeSingleRegisterStep" },
          { "$ref": "#/definitions/delayStep" },
          { "$ref": "#/definitions/reopenSerialStep" },
          { "$ref": "#/definitions/assertEqualsStep" }
        ]
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/legacyOutput" },
          { "$ref": "#/definitions/outputV2" }
        ]
      }
    },
    "onError": { "const": "stop" }
  },
  "definitions": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "variableName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "variableReference": {
      "type": "string",
      "pattern": "^\\$\\{[A-Za-z][A-Za-z0-9_]*\\}$"
    },
    "mapLookup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["map", "key"],
      "properties": {
        "map": { "$ref": "#/definitions/id" },
        "key": { "$ref": "#/definitions/variableReference" }
      }
    },
    "value": {
      "oneOf": [
        { "type": "number" },
        { "$ref": "#/definitions/variableReference" },
        { "$ref": "#/definitions/mapLookup" }
      ]
    },
    "stepBase": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": { "type": "string" }
      }
    },
    "integerParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "minimum", "maximum"],
      "properties": {
        "name": { "$ref": "#/definitions/variableName" },
        "label": { "type": "string", "minLength": 1 },
        "type": { "const": "integer" },
        "minimum": { "type": "integer" },
        "maximum": { "type": "integer" }
      }
    },
    "enumParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "values"],
      "properties": {
        "name": { "$ref": "#/definitions/variableName" },
        "label": { "type": "string", "minLength": 1 },
        "type": { "const": "enum" },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "anyOf": [
              { "type": "string" },
              { "type": "number" }
            ]
          }
        }
      }
    },
    "readHoldingRegistersStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "slaveId", "address", "count", "saveAs"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": { "const": "readHoldingRegisters" },
        "slaveId": { "$ref": "#/definitions/value" },
        "address": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "count": { "type": "integer", "minimum": 1, "maximum": 125 },
        "saveAs": { "$ref": "#/definitions/variableName" }
      }
    },
    "writeSingleRegisterStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "slaveId", "address", "value"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": { "const": "writeSingleRegister" },
        "slaveId": { "$ref": "#/definitions/value" },
        "address": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "value": { "$ref": "#/definitions/value" }
      }
    },
    "delayStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "milliseconds"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": { "const": "delay" },
        "milliseconds": { "type": "integer", "minimum": 0, "maximum": 60000 }
      }
    },
    "reopenSerialStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "baudRate"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": { "const": "reopenSerial" },
        "baudRate": { "$ref": "#/definitions/value" }
      }
    },
    "assertEqualsStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "actual", "expected"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": { "const": "assertEquals" },
        "actual": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\[[0-9]+\\])?$"
        },
        "expected": { "$ref": "#/definitions/value" }
      }
    },
    "legacyOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "decoder"],
      "properties": {
        "name": { "$ref": "#/definitions/id" },
        "source": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*\\[[0-9]+\\]$"
        },
        "decoder": { "enum": ["uint16", "int16"] },
        "scale": { "type": "number" },
        "offset": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 }
      }
    },
    "outputSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variable", "start", "count"],
      "properties": {
        "variable": { "$ref": "#/definitions/variableName" },
        "start": { "type": "integer", "minimum": 0 },
        "count": { "type": "integer", "minimum": 1, "maximum": 125 }
      }
    },
    "decoderBaseProperties": {
      "registerOrder": { "enum": ["high-word-first", "low-word-first"] },
      "byteOrder": { "enum": ["high-byte-first", "low-byte-first"] }
    },
    "numeric16Decoder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["uint16", "int16"] }
      }
    },
    "multiRegisterNumericDecoder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["uint32", "int32", "float32", "float64"] },
        "registerOrder": { "enum": ["high-word-first", "low-word-first"] },
        "byteOrder": { "enum": ["high-byte-first", "low-byte-first"] }
      }
    },
    "bitDecoder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "bitIndex"],
      "properties": {
        "type": { "const": "bit" },
        "bitIndex": { "type": "integer", "minimum": 0, "maximum": 15 },
        "registerOrder": { "enum": ["high-word-first", "low-word-first"] },
        "byteOrder": { "enum": ["high-byte-first", "low-byte-first"] }
      }
    },
    "asciiDecoder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "ascii" },
        "trim": { "enum": ["none", "null", "null-and-space"] },
        "registerOrder": { "enum": ["high-word-first", "low-word-first"] },
        "byteOrder": { "enum": ["high-byte-first", "low-byte-first"] }
      }
    },
    "hexDecoder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "hex" },
        "registerOrder": { "enum": ["high-word-first", "low-word-first"] },
        "byteOrder": { "enum": ["high-byte-first", "low-byte-first"] }
      }
    },
    "decoder": {
      "oneOf": [
        { "$ref": "#/definitions/numeric16Decoder" },
        { "$ref": "#/definitions/multiRegisterNumericDecoder" },
        { "$ref": "#/definitions/bitDecoder" },
        { "$ref": "#/definitions/asciiDecoder" },
        { "$ref": "#/definitions/hexDecoder" }
      ]
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "scale": { "type": "number" }, "offset": { "type": "number" } }
    },
    "format": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "number" }, "fractionDigits": { "type": "integer", "minimum": 0, "maximum": 12 }, "unit": { "type": "string", "minLength": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "text" } } },
        { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "boolean" }, "trueLabel": { "type": "string" }, "falseLabel": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "values"], "properties": { "type": { "const": "enum" }, "values": { "type": "object", "minProperties": 1, "maxProperties": 256, "additionalProperties": { "type": "string", "maxLength": 160 } } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "formatterId"], "properties": { "type": { "const": "custom" }, "formatterId": { "$ref": "#/definitions/id" }, "options": { "type": "object", "maxProperties": 16, "additionalProperties": { "anyOf": [{ "type": "string", "maxLength": 160 }, { "type": "number" }, { "type": "boolean" }] } } } }
      ]
    },
    "outputV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "decode", "format"],
      "properties": {
        "name": { "$ref": "#/definitions/id" },
        "source": { "$ref": "#/definitions/outputSource" },
        "decode": { "$ref": "#/definitions/decoder" },
        "transform": { "$ref": "#/definitions/transform" },
        "format": { "$ref": "#/definitions/format" }
      }
    }
  }
}
