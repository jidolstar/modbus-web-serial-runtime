{
  "name": "modbus-manager-backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "nest build",
    "db:migrate": "tsx src/database/migrate-cli.ts up",
    "db:migrate:down": "tsx src/database/migrate-cli.ts down",
    "db:migrate:status": "tsx src/database/migrate-cli.ts status",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "@nestjs/common": "^12.0.4",
    "@nestjs/core": "^12.0.4",
    "@nestjs/platform-fastify": "^12.0.4",
    "@nestjs/swagger": "^12.0.1",
    "jose": "^5.10.0",
    "kysely": "^0.29.6",
    "mysql2": "^3.24.4",
    "openid-client": "^5.7.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.3",
    "@types/node": "^24.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3"
  }
}
