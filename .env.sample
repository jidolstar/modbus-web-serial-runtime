# 이 파일을 `.env`로 복사한 뒤 배포 환경에 맞게 값을 변경한다.
# Docker Compose는 root `.env`를 읽는다. VITE_* 값은 브라우저 번들에 포함되는 공개 설정이다.

# Frontend 공개 설정: 브라우저에서 사용할 API 주소와 개발 서버·통신 타이밍이다.
# VITE_API_BASE_URL은 브라우저가 접근 가능한 URL이어야 하며 /api 경로를 포함한다.
VITE_API_BASE_URL=https://api.example.com/api
VITE_ALLOWED_HOSTS=app.example.com,modbus-frontend
# 측정 사이 간격(ms). 허용 범위 250~60000, 기본값 3000.
VITE_SENSOR_POLL_INTERVAL_MS=3000
# Modbus 요청 timeout(ms). 허용 범위 100~60000, 기본값 1200.
VITE_MODBUS_TRANSACTION_TIMEOUT_MS=1200

# Backend 기본 설정
NODE_ENV=development
PORT=3000
# 서버 실행 환경(development/test/production)과 수신 포트(1~65535, 기본값 3000)
# 인증 redirect, CORS 허용, HTTPS SEO origin에 공통으로 쓰는 Frontend origin. 경로와 끝의 / 없이 지정한다.
CORS_ORIGIN=https://app.example.com

# Google OpenID Connect. 네 값이 모두 있어야 로그인이 활성화된다.
# Client secret은 서버 전용이며 실제 .env에만 입력한다. callback URL은 Google 설정과 일치해야 한다.
GOOGLE_OIDC_CLIENT_ID=example.apps.googleusercontent.com
GOOGLE_OIDC_CLIENT_SECRET=replace_with_secret
GOOGLE_OIDC_CALLBACK_URL=https://api.example.com/api/auth/google/callback
AUTH_ALLOWED_EMAILS=admin@example.com,operator@example.com

# 서버 관리형 인증 세션. JWT_SECRET은 32바이트 이상의 무작위 값으로 교체한다.
JWT_SECRET=replace_with_at_least_32_random_bytes
# 로그인 세션 수명(초), 허용 범위 300~86400, 기본값 28800.
AUTH_SESSION_TTL_SECONDS=28800
AUTH_COOKIE_NAME=modbus_session

# 외부 MySQL 8.4 연결. DB와 전용 앱 계정은 미리 만들며 Backend migration이 테이블을 관리한다.
# DATABASE_HOST는 Backend 컨테이너에서 접근할 주소다. DATABASE_SSL은 true 또는 false.
DATABASE_HOST=mysql-8.4
DATABASE_PORT=3306
DATABASE_NAME=modbus_studio
DATABASE_USER=modbus_app
DATABASE_PASSWORD=replace_with_random_password
DATABASE_SSL=false

# Catalog 첨부 자료는 web root 밖 Backend 전용 경로에 저장한다. Compose는 named volume으로 보존한다.
CATALOG_UPLOAD_ROOT=/var/lib/modbus-studio/catalog-uploads
# 일반 참고 파일 최대 크기(byte), 허용 범위 1024~104857600, 기본값 20971520.
CATALOG_FILE_MAX_BYTES=20971520
# 썸네일 업로드 최대 크기(byte), 허용 범위 1024~26214400, 기본값 10485760.
CATALOG_THUMBNAIL_MAX_BYTES=10485760
# 선택 설정: 비워 두면 AI Catalog 작성·수정 기능을 사용할 수 없다. Backend만 읽으며 Git에 커밋하지 않는다.
GEMINI_API_KEY=
# 사용할 Gemini 모델 ID. 생략 시 기본값 gemini-3.5-flash-lite.
GEMINI_CATALOG_MODEL=gemini-3.5-flash-lite
# Gemini 요청 timeout(ms), 허용 범위 30000~600000, 기본값 300000.
GEMINI_CATALOG_TIMEOUT_MS=300000
# Gemini 요청·응답 감사 row 보관 일수(1~365, 기본값 90). AI 임시 업로드 파일 TTL과는 별개다.
GEMINI_AUDIT_RETENTION_DAYS=90
