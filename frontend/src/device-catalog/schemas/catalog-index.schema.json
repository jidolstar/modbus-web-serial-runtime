{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "catalog-index.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profiles", "recipes"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "pattern": "^[^/].*\\.json$" }
    },
    "recipes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "pattern": "^[^/].*\\.json$" }
    }
  }
}
