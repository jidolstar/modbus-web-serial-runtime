{
  "schemaVersion": "1.0",
  "id": "cwt-th04s.probe",
  "name": "CWT-TH04S 존재 확인",
  "kind": "probe",
  "parameters": [
    {
      "name": "deviceId",
      "label": "현재 Slave ID",
      "type": "integer",
      "minimum": 1,
      "maximum": 247
    }
  ],
  "steps": [
    {
      "id": "read-measurement-registers",
      "type": "readHoldingRegisters",
      "slaveId": "${deviceId}",
      "address": 0,
      "count": 2,
      "saveAs": "probeRegisters"
    }
  ],
  "onError": "stop"
}
