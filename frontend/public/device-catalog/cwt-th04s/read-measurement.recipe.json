{
  "schemaVersion": "2.0",
  "id": "cwt-th04s.read-measurement",
  "name": "CWT-TH04S 온습도 읽기",
  "kind": "measurement",
  "parameters": [
    {
      "name": "deviceId",
      "label": "현재 Slave ID",
      "type": "integer",
      "minimum": 1,
      "maximum": 247
    }
  ],
  "steps": [
    {
      "id": "read-measurement-registers",
      "type": "readHoldingRegisters",
      "slaveId": "${deviceId}",
      "address": 0,
      "count": 2,
      "saveAs": "measurementRegisters"
    }
  ],
  "outputs": [
    {
      "name": "humidity",
      "source": { "variable": "measurementRegisters", "start": 0, "count": 1 },
      "decode": { "type": "uint16" },
      "transform": { "scale": 0.1 },
      "format": { "type": "number", "fractionDigits": 1, "unit": "%RH" }
    },
    {
      "name": "temperature",
      "source": { "variable": "measurementRegisters", "start": 1, "count": 1 },
      "decode": { "type": "int16" },
      "transform": { "scale": 0.1 },
      "format": { "type": "number", "fractionDigits": 1, "unit": "°C" }
    }
  ],
  "onError": "stop"
}
